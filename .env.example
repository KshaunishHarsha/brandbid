# Copy to .env.local (web) / .env (worker). Never commit real values.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # https://brandbid.wtf in production
APP_ENV=local                                # local | staging | production

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=               # from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=                   # server only. NEVER expose to the browser
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres  # DIRECT connection (session mode), used by the worker/pg-boss

# --- Privacy / hashing ---
IP_PEPPER=                                   # HMAC key for IP/UA/fingerprint hashes. Never rotate casually (BUILD s20)

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Cloudflare test key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  # Cloudflare test key

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Razorpay (bids in, USD) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=brandbid <noreply@brandbid.wtf>

# --- Observability ---
NEXT_PUBLIC_SENTRY_DSN=                      # web
WORKER_SENTRY_DSN=                           # worker
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
