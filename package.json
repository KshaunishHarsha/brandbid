{
  "name": "brandbid",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm lint:migrations && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:sql": "bash packages/db/run-sql-tests.sh",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/types.ts",
    "seed": "tsx packages/db/scripts/seed-demo.ts",
    "simulate:clicks": "tsx scripts/simulate-clicks.ts",
    "format": "prettier --write .",
    "test:concurrency": "tsx packages/db/tests/concurrency-record-bid.ts && tsx packages/db/tests/concurrency-qualify.ts",
    "test:worker": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" tsx apps/worker/src/jobs/check-listing.integration.ts && DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" tsx apps/worker/src/jobs/admin-jobs.integration.ts",
    "admin:grant": "bash scripts/grant-admin.sh",
    "lint:migrations": "bash packages/db/check-migrations.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
